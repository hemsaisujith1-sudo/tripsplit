{
  "version": 2,
  "buildCommand": "echo 'No build step required'",
  "installCommand": "npm install --production=false",
  "outputDirectory": ".",
  "functions": {
    "server.js": {
      "includeFiles": "**/*.{html,css,js,json,env}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/((?!_vercel|api).*)", "destination": "/index.html" }
  ]
}
