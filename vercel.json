{
  "version": 2,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "{models,routes,config,controllers}/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/not-found.html" }
  ]
}
